# When set, Buffer is used instead of the direct X API. No fallback on errors.
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=

# Legacy direct X API credentials (only used without BUFFER_API_KEY).
KZT_TWITTER_ACCESS_TOKEN=
KZT_TWITTER_ACCESS_TOKEN_SECRET=
KZT_TWITTER_CONSUMER_KEY=
KZT_TWITTER_CONSUMER_SECRET=

NODE_ENV=development
DEBUG=false
FORCE_UPDATE=false
KZT_RATES_DB_FILE=
